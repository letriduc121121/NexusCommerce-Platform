{
	"info": {
		"_postman_id": "cart-service-collection",
		"name": "Cart Service API Collection",
		"description": "Bộ Postman Collection đầy đủ để kiểm thử Cart Service (cổng 8086) thông qua API Gateway (cổng 8000).\n\n## Luồng kiểm thử:\n1. Gọi API **0. Login lấy Token** để đăng nhập và tự động lưu `user_token`.\n2. Gọi **1. Thêm vào giỏ hàng** với `productId` bất kỳ.\n3. Gọi **2. Xem giỏ hàng** để xem danh sách món ăn/sản phẩm đã thêm.\n4. Gọi **3. Cập nhật số lượng**.\n5. Gọi **4. Xóa 1 sản phẩm** hoặc **5. Xóa sạch giỏ hàng**.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "gateway_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "user_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "product_id",
			"value": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "0. Login lấy Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.token) {",
							"    pm.collectionVariables.set(\"user_token\", jsonData.token);",
							"    console.log(\"Đã lưu user_token thành công!\");",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"User123@\"\n}"
				},
				"url": {
					"raw": "{{gateway_url}}/api/v1/auth/login",
					"host": [
						"{{gateway_url}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"login"
					]
				}
			}
		},
		{
			"name": "1. Xem giỏ hàng",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{user_token}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{gateway_url}}/api/v1/cart",
					"host": [
						"{{gateway_url}}"
					],
					"path": [
						"api",
						"v1",
						"cart"
					]
				}
			}
		},
		{
			"name": "2. Thêm sản phẩm vào giỏ",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{user_token}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"productId\": \"{{product_id}}\",\n  \"quantity\": 2\n}"
				},
				"url": {
					"raw": "{{gateway_url}}/api/v1/cart/items",
					"host": [
						"{{gateway_url}}"
					],
					"path": [
						"api",
						"v1",
						"cart",
						"items"
					]
				}
			}
		},
		{
			"name": "3. Cập nhật số lượng sản phẩm",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{user_token}}",
							"type": "string"
						}
					]
				},
				"method": "PUT",
				"header": [],
				"url": {
					"raw": "{{gateway_url}}/api/v1/cart/items/{{product_id}}?quantity=5",
					"host": [
						"{{gateway_url}}"
					],
					"path": [
						"api",
						"v1",
						"cart",
						"items",
						"{{product_id}}"
					],
					"query": [
						{
							"key": "quantity",
							"value": "5"
						}
					]
				}
			}
		},
		{
			"name": "4. Xóa 1 sản phẩm khỏi giỏ",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{user_token}}",
							"type": "string"
						}
					]
				},
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{gateway_url}}/api/v1/cart/items/{{product_id}}",
					"host": [
						"{{gateway_url}}"
					],
					"path": [
						"api",
						"v1",
						"cart",
						"items",
						"{{product_id}}"
					]
				}
			}
		},
		{
			"name": "5. Xóa sạch giỏ hàng",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{user_token}}",
							"type": "string"
						}
					]
				},
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{gateway_url}}/api/v1/cart",
					"host": [
						"{{gateway_url}}"
					],
					"path": [
						"api",
						"v1",
						"cart"
					]
				}
			}
		}
	]
}
