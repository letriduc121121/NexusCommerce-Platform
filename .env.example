# ================================================================
# NexusCommerce Environment Configuration Template (.env.example)
# Copy this file to .env before running docker-compose or services:
#   cp .env.example .env
# ================================================================

# 🔐 JWT Secret (Required for token authentication across all microservices)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# 🖼 Cloudinary Storage (Required for Product Service image upload)
# Register at https://cloudinary.com to obtain your credentials
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# 💳 VNPay Payment Gateway (Required for Payment Service Sandbox testing)
# Register at https://sandbox.vnpayment.vn to obtain test credentials
VNPAY_TMN_CODE=your-tmn-code
VNPAY_HASH_SECRET=your-hash-secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:4200/checkout/vnpay-callback

# 📧 Email Notification Credentials (Optional for Notification Service)
# Generate Gmail App Password at myaccount.google.com -> Security -> App passwords
# If left empty, Notification Service will log email body to console instead of sending.
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_NAME=Ecommerce Shop
